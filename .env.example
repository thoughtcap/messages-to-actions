# OpenAI
OPENAI_API_KEY=sk-...

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: shown on traces; CI/version tags
# LANGFUSE_RELEASE=1.0.0
# Set to true to omit prompt/completion text from Langfuse (metadata/tags still sent)
# LANGFUSE_MASK_MESSAGE_CONTENT=false

# Notion
NOTION_API_KEY=ntn_...
NOTION_DATABASE_ID=your-database-id-here

# Slack (optional — for webhook verification)
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Server
PORT=4111
